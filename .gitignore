node_modules/
.next/
out/
public/cesium/
.env
.env.local
__pycache__/
*.pyc
.DS_Store
next-env.d.ts
*.tsbuildinfo
# Tooling scratch: Playwright MCP capture, project probe screenshots.
.playwright-mcp/
site-probe.png
# Manual edits are local demonstration state, never a register, and are never
# committed. One file per project now -- see lib/data/edits.ts. The
# pre-multi-project global file is still ignored because it is still read once,
# copied into the demo project's path, and deliberately left in place.
data/edits.json
data/projects/*/edits.json

# The verbatim Overpass responses. A local cache so a re-seed never has to ask
# Overpass again -- and a record of exactly what the pipeline was handed, which
# is worth having on disk. Not committed: it is a byte-for-byte duplicate of
# the raw_*.geojson files beside it, which ARE committed, and it is the largest
# file in a project's work directory.
data/projects/*/osm.json
# Added when the project was linked to Vercel. `.env*` would otherwise shadow
# .env.example, which IS committed as the documented list of settings, so the
# example is negated back in.
.vercel
.env*
!.env.example

# Local perf artifacts: sha256 baselines, sample bodies, RWD gallery screenshots.
# None of these are inputs to the build -- they are by-products of probes and
# acceptance runs, and a fresh checkout regenerates them.
.dist/
docs/shots/rwd-gallery/

# Raw CartoDEM tiles (NRSC/ISRO, 1 arc-second, ~50 MB per 1x1 degree tile).
# Not committed: scripts/dem.py clips one to the project bbox as dem.tif, which
# is a few kilobytes and IS committed, so a re-seed never needs the raw tile.
data/projects/*/dem_raw.tif
data/projects/*/*_DEM_*.tif
# The seed-only geo toolchain (micromamba env: gdal, rasterio, pyproj). Only
# the DEM stage needs it; every other stage is stdlib.
.gdal-env/
