# Cesium ion access token. Optional, and affects TERRAIN and the Photoreal
# building style: without it the globe falls back to an ellipsoid, and Google
# Photorealistic 3D Tiles cannot be brokered (the Buildings toggle then falls
# back to Schematic and says why). Basemap imagery is Esri World Imagery and
# needs no token at all.
NEXT_PUBLIC_CESIUM_TOKEN=

# Google Maps API key. Optional: only needed to bill Google Photorealistic 3D
# Tiles against your own key instead of going through Cesium ion. Leave unset
# to use ion, which is the normal path.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Drone orthophoto XYZ tile template, e.g. /ortho/{z}/{x}/{y}.png for a pyramid
# served out of /public. Optional: the "Drone orthophoto (local)" entry is
# hidden from the imagery picker entirely when this is unset. Requests are
# bounded to the AOI, so no tile outside the flight is ever asked for.
NEXT_PUBLIC_DRONE_ORTHO_URL=

# Attribution shown for the drone ortho. Defaults to a generic string.
NEXT_PUBLIC_DRONE_ORTHO_CREDIT=

# Mapbox access token. Optional: purely to add "Mapbox Satellite" to the
# imagery picker. The option is hidden entirely when this is unset.
NEXT_PUBLIC_MAPBOX_TOKEN=

# HMAC key the ulpin_session cookie is signed with. REQUIRED for any
# deployment that runs more than one server process -- which on Vercel is
# every deployment, because each serverless instance is its own process.
#
# When this is unset the app falls back to a random key generated per
# process. That is fine for a single local `next dev`, and broken everywhere
# else: the instance that handles POST /api/auth/*/login signs the cookie
# with its key, the instance that renders the next page verifies it with a
# different one, the signature check fails, and the user is redirected back
# to /login. The symptom is a login form that reappears on submit with no
# error message, which looks like rejected credentials but is not.
#
# Any stable, high-entropy string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PostGIS connection used by the API route handlers. If unreachable, the
# handlers transparently serve the committed snapshots in /data instead.
DATABASE_URL=postgresql://ulpin:ulpin@localhost:55432/ulpin

# Redis URL for the per-endpoint read-through cache (per-building detail,
# conflict set, 3D point query). Optional: when unset, every cache read
# short-circuits to "bypass" and the in-process LRU in lib/server-cache.ts
# is the only cache. ioredis accepts both redis:// and rediss://; the
# wrapper uses lazyConnect, connectTimeout=1s, maxRetriesPerRequest=1, and
# enableOfflineQueue=false, so a missing or stopped Redis is silent and
# one-shot logged rather than a request failure.
ULPIN_REDIS_URL=redis://localhost:6379

# Cache key version segment. Every Redis key starts with this; bumping the
# value flushes every cached entry without touching Redis directly -- the
# new keys are simply unreachable from the old ones and the next request
# writes them under the new prefix. Bump after a re-seed, an exporter
# change, or any other change to the shape of the cached value.
ULPIN_CACHE_VERSION=1
