# Cesium ion access token. Optional, and affects TERRAIN and the Photoreal
# building style: without it the globe falls back to an ellipsoid, and Google
# Photorealistic 3D Tiles cannot be brokered (the Buildings toggle then falls
# back to Schematic and says why). Basemap imagery is Esri World Imagery and
# needs no token at all.
NEXT_PUBLIC_CESIUM_TOKEN=

# Google Maps API key. Optional: only needed to bill Google Photorealistic 3D
# Tiles against your own key instead of going through Cesium ion. Leave unset
# to use ion, which is the normal path.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Drone orthophoto XYZ tile template, e.g. /ortho/{z}/{x}/{y}.png for a pyramid
# served out of /public. Optional: the "Drone orthophoto (local)" entry is
# hidden from the imagery picker entirely when this is unset. Requests are
# bounded to the AOI, so no tile outside the flight is ever asked for.
NEXT_PUBLIC_DRONE_ORTHO_URL=

# Attribution shown for the drone ortho. Defaults to a generic string.
NEXT_PUBLIC_DRONE_ORTHO_CREDIT=

# Mapbox access token. Optional: purely to add "Mapbox Satellite" to the
# imagery picker. The option is hidden entirely when this is unset.
NEXT_PUBLIC_MAPBOX_TOKEN=

# PostGIS connection used by the API route handlers. If unreachable, the
# handlers transparently serve the committed snapshots in /data instead.
DATABASE_URL=postgresql://ulpin:ulpin@localhost:55432/ulpin
